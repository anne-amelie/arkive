{
  "expo": {
    "name": "Arkive",
    "slug": "arkive",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0e10",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arkive.app"
    },
    "android": {
      "package": "com.arkive.app",
      "adaptiveIcon": {
        "backgroundColor": "#0e0e10"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e0e10"
        }
      ],
      "expo-image"
    ]
  }
}
